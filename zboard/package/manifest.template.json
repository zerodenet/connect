{
  "schema_version": 1,
  "id": "org.zerodenet.connect.zboard",
  "name": "Connect for ZBoard",
  "description": "Reference provider adapter that authorizes compatible clients and serves entitled subscriptions and read-only messages over Connect.",
  "version": "0.0.1",
  "requires": {
    "zboard": ">=0.0.2 <0.1.0",
    "recommended_zboard_version": "0.0.2",
    "tested_zboard_versions": [
      "v0.0.2-rc.202609210457"
    ],
    "plugin_protocol": 1,
    "ui_bridge": 1
  },
  "capabilities": [
    "zboard.ui.page.v1",
    "zboard.config.v1",
    "zboard.storage.v1",
    "zboard.http.route.v1",
    "zboard.account.assertion.v1",
    "zboard.subscription.projection.v1",
    "zboard.message.projection.v1"
  ],
  "surfaces": [
    "account",
    "admin"
  ],
  "components": {
    "ui": {
      "account": "ui/account/index.html",
      "admin": "ui/admin/index.html"
    },
    "server": {
      "executables": {
        "linux-amd64": "runtimes/linux-amd64/connect",
        "linux-arm64": "runtimes/linux-arm64/connect",
        "darwin-amd64": "runtimes/darwin-amd64/connect",
        "darwin-arm64": "runtimes/darwin-arm64/connect",
        "windows-amd64": "runtimes/windows-amd64/connect.exe"
      }
    }
  },
  "data": {
    "version": 1,
    "min_compatible_version": 1,
    "migrations": [
      {
        "version": 1,
        "changes": []
      }
    ]
  },
  "contributions": {
    "pages": [
      {
        "id": "authorized-devices",
        "surface": "account",
        "title": "客户端授权",
        "purpose": "business"
      },
      {
        "id": "client-communication",
        "surface": "admin",
        "title": "客户端通信",
        "purpose": "configuration"
      }
    ],
    "http_routes": [
      {
        "id": "capabilities",
        "method": "GET",
        "path": "/.well-known/zerodenet-connect/v1/capabilities"
      },
      {
        "id": "exchange",
        "method": "POST",
        "path": "/.well-known/zerodenet-connect/v1/exchange"
      }
    ]
  },
  "files": {}
}
