{
  "schema_version": 1,
  "id": "org.zerodenet.zboard.server",
  "name": "ZBoard client integration",
  "description": "Authorizes ZNet Sink devices and serves entitled subscriptions and read-only messages over the dedicated plugin protocol.",
  "version": "0.0.1",
  "requires": {
    "zboard": ">=0.0.2 <0.1.0",
    "recommended_zboard_version": "0.0.2",
    "tested_zboard_versions": [],
    "plugin_protocol": 1,
    "ui_bridge": 1
  },
  "capabilities": [
    "zboard.ui.page.v1",
    "zboard.config.v1",
    "zboard.storage.v1"
  ],
  "surfaces": [
    "account",
    "admin"
  ],
  "components": {
    "ui": {
      "account": "ui/account/index.html",
      "admin": "ui/admin/index.html"
    },
    "server": {
      "executables": {
        "linux-amd64": "runtimes/linux-amd64/zboard-plugin"
      }
    }
  },
  "contributions": {
    "pages": [
      {
        "id": "authorized-devices",
        "surface": "account",
        "title": "客户端授权",
        "purpose": "business"
      },
      {
        "id": "client-communication",
        "surface": "admin",
        "title": "客户端通信",
        "purpose": "configuration"
      }
    ]
  },
  "files": {}
}
