{
  "id": "org.zerodenet.connect",
  "name": "Connect",
  "description": "Connects compatible subscription providers and clients for device authorization, managed subscription synchronization, and read-only provider messages.",
  "categories": [
    "integration",
    "network"
  ],
  "license": "MPL-2.0",
  "maintainers": [
    "zerodenet"
  ],
  "repository": "https://github.com/zerodenet/connect",
  "documentation": "https://github.com/zerodenet/connect/blob/main/README.md",
  "security": "https://github.com/zerodenet/connect/blob/main/SECURITY.md",
  "publisher": {
    "id": "zerodenet",
    "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "release_source": {
    "type": "github-releases",
    "metadata_asset": "marketplace-entry.json"
  },
  "targets": [
    {
      "host": "zboard",
      "package_id": "org.zerodenet.connect.zboard",
      "surfaces": [
        "account",
        "admin"
      ],
      "capabilities": [
        "zboard.ui.page.v1",
        "zboard.config.v1",
        "zboard.storage.v1",
        "zboard.http.route.v1",
        "zboard.account.assertion.v1",
        "zboard.subscription.projection.v1",
        "zboard.message.projection.v1"
      ]
    },
    {
      "host": "znet-sink",
      "package_id": "org.zerodenet.connect.znet-sink",
      "surfaces": [
        "znet-sink.ui.management.v1"
      ],
      "capabilities": [
        "network.configured.request",
        "secrets.persistent.read",
        "secrets.persistent.write",
        "crypto.device.use",
        "subscriptions.manage",
        "plugin.storage.read",
        "plugin.storage.write",
        "notifications.post",
        "tasks.schedule"
      ]
    }
  ]
}
